local cards_manager = require("gameplay.cards.cards_manager")
local constants = require("utility.constants")
local press = require("utility.press_animator")

function init(self)
	self.data = nil
	self.dragging = false
	self.offset = vmath.vector3(0, 0, 0)

	self.half_w = constants.half_w
	self.half_h = constants.half_h
	self.merge_radius = constants.merge_radius 

	self.my_key = tostring(go.get_id())

	self.is_click = false
	self.start_mouse = nil
	self.click_threshold = 15

	msg.post(".", "acquire_input_focus")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup_card") then
		self.data = message
		if message.image then
			sprite.play_flipbook("#card_image", hash(message.image))
		end
		if message.name then
			label.set_text("#card_text", message.name)
		end
		if message.rarity then
			sprite.play_flipbook("#card_bg", hash(message.rarity))
		end
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then return end

	local pos = go.get_position()
	local mouse = vmath.vector3(action.x, action.y, 0)

	if action.pressed then
		if cards_manager.is_dragging() then
			return
		end

		local dx = math.abs(mouse.x - pos.x)
		local dy = math.abs(mouse.y - pos.y)

		if dx < self.half_w and dy < self.half_h then
			self.dragging = true
			self.is_click = true
			self.start_mouse = vmath.vector3(mouse)
			self.offset = pos - mouse

			cards_manager.set_dragging(self.my_key)
			press.down(".")
		end

	elseif action.released then
		if self.dragging then
			press.up(".")
			cards_manager.clear_dragging()
			cards_manager.save_field()
		end

		if self.is_click and self.data then
			local reward = self.data.reward or 1
			cards_manager.add_money(reward)
		end

		self.dragging = false
		self.is_click = false
		self.start_mouse = nil

	elseif self.dragging then
		go.set_position(mouse + self.offset)

		if self.start_mouse and vmath.length(mouse - self.start_mouse) > self.click_threshold then
			self.is_click = false
		end
	end
end

function update(self, dt)
	if not self.dragging or not self.data then return end

	local my_pos = go.get_position()
	local active_cards = cards_manager.get_active_cards()

	for other_key, card_info in pairs(active_cards) do
		if other_key ~= self.my_key then
			local other_pos = go.get_position(card_info.url)
			local dist = vmath.length(my_pos - other_pos)

			if dist < self.merge_radius then
				if cards_manager.try_merge(self.my_key, other_key) then
					self.dragging = false
					return 
				end
			end
		end
	end
end