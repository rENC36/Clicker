local cards_manager = require("gameplay.cards.cards_manager")
local constants = require("utility.constants")
local press = require("utility.press_animator")

function init(self)
	self.data = nil
	self.dragging = false
	self.offset = vmath.vector3(0, 0, 0)

	self.half_w = constants.half_w
	self.half_h = constants.half_h
	self.merge_radius = constants.merge_radius 

	self.my_key = tostring(go.get_id())

	self.is_click = false
	self.start_mouse = nil
	self.click_threshold = 15
	
	local ok, reward_pos = pcall(go.get, "#reward_text", "position")
	if ok then
		self.has_reward_text = true
		self.reward_text_base_pos = vmath.vector3(reward_pos.x, reward_pos.y, constants.REWARD_POPUP_LOCAL_Z)
		go.set("#reward_text", "position", self.reward_text_base_pos)
		go.set("#reward_text", "color", vmath.vector4(1, 1, 1, 0))
	else
		self.has_reward_text = false
		print("WARN: 'reward_text' component not found on card.go — add a Label component with id 'reward_text' to see the '+reward' popup")
	end

	msg.post(".", "acquire_input_focus")
end

local function show_reward_popup(self, reward)
	if not self.has_reward_text then return end

	go.cancel_animations("#reward_text", "position")
	go.cancel_animations("#reward_text", "color")

	go.set("#reward_text", "position", self.reward_text_base_pos)
	go.set("#reward_text", "color", vmath.vector4(1, 1, 1, 1))
	label.set_text("#reward_text", "+" .. tostring(reward))

	local target_pos = vmath.vector3(
		self.reward_text_base_pos.x,
		self.reward_text_base_pos.y + constants.REWARD_POPUP_RISE,
		self.reward_text_base_pos.z
	)

	go.animate("#reward_text", "position", go.PLAYBACK_ONCE_FORWARD, target_pos, go.EASING_OUTQUAD, constants.REWARD_POPUP_DURATION)
	go.animate("#reward_text", "color", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 0), go.EASING_INQUAD, constants.REWARD_POPUP_DURATION)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup_card") then
		self.data = message
		if message.image then
			sprite.play_flipbook("#card_image", hash(message.image))
			
			local image_pos = go.get("#card_image", "position")
			go.set("#card_image", "position", vmath.vector3(image_pos.x, image_pos.y, constants.CARD_IMAGE_LOCAL_Z))
		end
		if message.name then
			label.set_text("#card_text", message.name)
		end
		if message.rarity then
			sprite.play_flipbook("#card_bg", hash(message.rarity))
		end
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then return end

	local pos = go.get_position()
	local mouse = vmath.vector3(action.x, action.y, 0)

	if action.pressed then
		if cards_manager.is_dragging() then
			return
		end

		local dx = math.abs(mouse.x - pos.x)
		local dy = math.abs(mouse.y - pos.y)

		if dx < self.half_w and dy < self.half_h then
			self.dragging = true
			self.is_click = true
			self.start_mouse = vmath.vector3(mouse)
			self.offset = pos - mouse

			cards_manager.set_dragging(self.my_key)
			press.down(".")
			
			go.set_position(vmath.vector3(pos.x, pos.y, constants.DRAG_Z))
		end

	elseif action.released then
		if self.dragging then
			press.up(".")
			cards_manager.clear_dragging()
			
			local p = go.get_position()
			go.set_position(vmath.vector3(p.x, p.y, 0))

			cards_manager.save_field()
		end

		if self.is_click and self.data then
			local reward = self.data.reward or 1
			cards_manager.add_money(reward)
			show_reward_popup(self, reward)
		end

		self.dragging = false
		self.is_click = false
		self.start_mouse = nil

	elseif self.dragging then
		go.set_position(vmath.vector3(mouse.x + self.offset.x, mouse.y + self.offset.y, constants.DRAG_Z))

		if self.start_mouse and vmath.length(mouse - self.start_mouse) > self.click_threshold then
			self.is_click = false
		end
	end
end

function update(self, dt)
	if not self.dragging or not self.data then return end

	local my_pos = go.get_position()
	local active_cards = cards_manager.get_active_cards()

	for other_key, card_info in pairs(active_cards) do
		if other_key ~= self.my_key then
			local other_pos = go.get_position(card_info.url)
			local dist = vmath.length(my_pos - other_pos)

			if dist < self.merge_radius then
				if cards_manager.try_merge(self.my_key, other_key) then
					self.dragging = false
					return 
				end
			end
		end
	end
end
